# ============================================================================
# Runtime e banco
# Classification:
# - required: obrigatoria para runtime
# - optional: pode ficar vazia sem quebrar boot
# - conditional: obrigatoria somente quando recurso especifico for habilitado/acionado
# - sensitive: nunca versionar valor real
# - public: valor operacional, sem segredo
# ============================================================================

# [required][sensitive] String de conexao MongoDB.
MONGODB_URI=mongodb://localhost:27017/escalas_app_local
# [optional][public] Nome do banco; fallback interno: "escalas_app".
MONGODB_DB_NAME=escalas_app
# [optional][public] Controlado pelo runtime (`development`, `test`, `production`).
# Em producao, preferir valor gerenciado pela plataforma de deploy.
NODE_ENV=development

# [optional][public] Metadados de UI/public runtime.
NEXT_PUBLIC_APP_NAME=Worship Team Hub
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ============================================================================
# Autenticacao/JWT
# ============================================================================

# [required][sensitive] Defina AO MENOS UMA:
# AUTH_JWT_SECRET ou JWT_SECRET (minimo recomendado: 32+ chars aleatorios).
AUTH_JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_SECRET=

# [optional][sensitive] Chaves legadas aceitas como fallback de verificacao no middleware.
# Nao usar como segredo principal de emissao de token em novos ambientes.
AUTH_SECRET=
SESSION_SECRET=
NEXTAUTH_SECRET=

# [optional][sensitive] Chaves publicas para validacao JWT assimetrica (RS256).
AUTH_JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY=
AUTH_PUBLIC_KEY=

# [optional][public] Issuer esperado na validacao do middleware.
AUTH_JWT_ISSUER=escalas-app/auth
JWT_ISSUER=

# [optional][public] Storage de refresh token:
# - vazio => persistencia padrao (MongoDB)
# - memory => somente testes/ambiente efemero
AUTH_REFRESH_STORE=

# [optional][public] Alias de cookie para compatibilidade entre clientes.
AUTH_COOKIE_NAME=access_token
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_JWT_COOKIE_NAME=access_token

# [optional][public] Controle do uso de transacoes MongoDB em fluxos multi-colecao.
# Valores aceitos:
# - enabled (padrao): tenta transacao com retry controlado
# - disabled: usa fluxo legado de compensacao manual
MONGODB_MULTI_COLLECTION_TRANSACTIONS=enabled

# [optional][public] Politica quando transacao nao e suportada no ambiente.
# Valores aceitos:
# - compensation (padrao): usa compensacao manual
# - disabled: retorna erro operacional explicito
MONGODB_MULTI_COLLECTION_TRANSACTIONS_FALLBACK=compensation

# ============================================================================
# Integracao YouTube
# ============================================================================

# [conditional][sensitive] Obrigatoria apenas quando integracao/endpoints YouTube
# estiverem habilitados/acionados em producao.
YOUTUBE_API_KEY=

# ============================================================================
# Rate limit
# ============================================================================

# [optional][public] Flags globais/categoriais.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_ENABLED=true
RATE_LIMIT_INTEGRATIONS_ENABLED=true

# [optional][public] Limites de autenticacao.
RATE_LIMIT_AUTH_LOGIN_MAX=5
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REFRESH_MAX=12
RATE_LIMIT_AUTH_REFRESH_WINDOW_SECONDS=60

# [optional][public] Limites de integracao YouTube.
RATE_LIMIT_YOUTUBE_SEARCH_MAX=30
RATE_LIMIT_YOUTUBE_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_YOUTUBE_PREVIEW_MAX=40
RATE_LIMIT_YOUTUBE_PREVIEW_WINDOW_SECONDS=60

# [optional][public] Simulacao de falha do store (uso em testes controlados).
RATE_LIMIT_STORE_FORCE_FAILURE=false

# ============================================================================
# Push notifications (Web Push / VAPID)
# ============================================================================

# [optional][public] Chave exposta ao navegador.
PUSH_VAPID_PUBLIC_KEY=
# [optional][sensitive] Chave privada VAPID.
PUSH_VAPID_PRIVATE_KEY=
# [optional][public] Contato operacional (formato mailto:).
PUSH_VAPID_SUBJECT=mailto:no-reply@escalas.app
